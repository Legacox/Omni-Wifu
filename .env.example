# Copia este archivo como ".env" (junto a main.py) y rellénalo. NO subas .env a GitHub.

# Base de datos de Supabase (aquí se guardan usuarios y claves API).
# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI).
# Si la contraseña tiene símbolos como @ # / :, escríbelos codificados (por ejemplo @ = %40).
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth (registro con código por correo): Project Settings > API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_CLAVE_ANON_PUBLIC

# Opcionales
# FISH_MODEL=s2.1-pro-free
# MIA_GEMINI_VOICE=Laomedeia
